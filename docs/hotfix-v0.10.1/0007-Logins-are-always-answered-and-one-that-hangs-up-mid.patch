From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 11:35:26 +0000
Subject: [PATCH 7/7] Logins are always answered, and one that hangs up midway
 leaves no ghost

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0165cfX3CZMtTWVCk9QNEtcV
---
 server/gameserver.go      | 46 +++++++++++++++++++++++++++++++++++++-
 server/gameserver_test.go | 47 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 92 insertions(+), 1 deletion(-)

diff --git a/server/gameserver.go b/server/gameserver.go
index 3788c7e..7fd4447 100644
--- a/server/gameserver.go
+++ b/server/gameserver.go
@@ -27,6 +27,10 @@ type GameServer struct {
 	store          player.Store
 	// bcryptCost is bcrypt.DefaultCost; tests turn it down to MinCost.
 	bcryptCost int
+	// inFlight is the connections with a hash away on a goroutine, and gone
+	// those of them that hung up meanwhile: world-goroutine only.
+	inFlight map[gameserver.Conn]bool
+	gone     map[gameserver.Conn]bool
 	// lastBeat is unix nanoseconds at the end of the last tick, for the
 	// health check (health.go); zero until Run starts.
 	lastBeat atomic.Int64
@@ -40,6 +44,8 @@ func New(w *world.World, c *rules.Catalog, s player.Store) *GameServer {
 		catalog:        c,
 		store:          s,
 		bcryptCost:     bcrypt.DefaultCost,
+		inFlight:       map[gameserver.Conn]bool{},
+		gone:           map[gameserver.Conn]bool{},
 	}
 }
 
@@ -170,14 +176,43 @@ func (gs *GameServer) dispatch(msg *gameserver.HandlerParameter) error {
 	case command.CreatePlayer:
 		return gs.handleCreatePlayer(msg, cmd)
 	case loginChecked:
+		if gs.hungUp(msg.Client) {
+			return nil
+		}
 		return gs.handleLoginChecked(msg, cmd)
 	case createHashed:
+		if gs.hungUp(msg.Client) {
+			return nil
+		}
 		return gs.handleCreateHashed(msg, cmd)
+	case command.Logout:
+		// the parameter's player was snapshotted when the Logout was built,
+		// maybe before a login queued ahead of it attached one: go by the
+		// connection's, or that just-logged-in character is left a ghost
+		msg.Player = msg.Client.Player()
+		if msg.Player == nil && gs.inFlight[msg.Client] {
+			// gone mid-login: what comes back for it is dropped, or the
+			// character would be in the world with nobody to play them and
+			// no Logout ever to come
+			gs.gone[msg.Client] = true
+		}
+		return gs.world.HandleIncomingMessage(msg)
 	default:
 		return gs.world.HandleIncomingMessage(msg)
 	}
 }
 
+// hungUp takes note that c's hash has come back, and answers whether c hung
+// up while it was away; if so, the answer is for nobody.
+func (gs *GameServer) hungUp(c gameserver.Conn) bool {
+	delete(gs.inFlight, c)
+	if gs.gone[c] {
+		delete(gs.gone, c)
+		return true
+	}
+	return false
+}
+
 func (gs *GameServer) Receive(msg *gameserver.HandlerParameter) {
 	gs.incomingBuffer <- msg
 }
@@ -231,6 +266,7 @@ func (gs *GameServer) handleLogin(msg *gameserver.HandlerParameter, cmd command.
 		return nil
 	}
 
+	gs.inFlight[msg.Client] = true
 	go func() {
 		ok := bcrypt.CompareHashAndPassword([]byte(rec.PasswordHash), []byte(cmd.Password)) == nil
 		gs.Receive(gameserver.NewHandlerParameter(msg.Client, loginChecked{Name: playerName, Ok: ok}))
@@ -301,8 +337,10 @@ func (gs *GameServer) handleCreatePlayer(msg *gameserver.HandlerParameter, cmd c
 		return nil
 	}
 	if len(cmd.Password) == 0 {
+		// answered here, so no error for recovering to answer a second time
+		log.Warn().Str("playerName", playerName).Msg("handleCreatePlayer: no password")
 		msg.Client.Send(event.CreateFailed{Reason: event.BadRequest})
-		return fmt.Errorf("handleCreatePlayer %s: %s", playerName, event.BadRequest)
+		return nil
 	}
 	if gs.world.IsReservedName(playerName) {
 		msg.Client.Send(event.CreateFailed{Reason: event.NameReserved})
@@ -337,6 +375,7 @@ func (gs *GameServer) handleCreatePlayer(msg *gameserver.HandlerParameter, cmd c
 
 	// separate go func because bcrypt is slooooow and can't be on the gameserver's goroutine.
 	// its ok because this doesn't modify any game / world state.
+	gs.inFlight[msg.Client] = true
 	go func() {
 		hash, err := bcrypt.GenerateFromPassword([]byte(cmd.Password), gs.bcryptCost)
 		if err != nil {
@@ -438,6 +477,11 @@ func (gs *GameServer) recovering(msg *gameserver.HandlerParameter, handle func(*
 	if err := handle(msg); err != nil {
 		// don't return error, we're not halting the server
 		log.Error().Err(err).Msg("error dispatching message")
+		// but answer a login: the connection is waiting on one, and would
+		// wait for good -- holding its address's slot -- on a store hiccup
+		if msg.Client.Player() == nil {
+			msg.Client.Send(event.LoginFailed{Reason: event.Unknown})
+		}
 	}
 }
 
diff --git a/server/gameserver_test.go b/server/gameserver_test.go
index 6d78bb4..d35b8ce 100644
--- a/server/gameserver_test.go
+++ b/server/gameserver_test.go
@@ -2,6 +2,7 @@ package server
 
 import (
 	"context"
+	"errors"
 	"os"
 	"testing"
 	"time"
@@ -399,3 +400,49 @@ func TestCreatePlayer_roomHearsAFirstArrival(t *testing.T) {
 
 	assert.Contains(t, old.sent, event.EnteredGame{Actor: "Newbie", First: true})
 }
+
+// A connection that hangs up while its password is being checked doesn't
+// come back as a character in the world with nobody there.
+func TestLogin_hungUpMidwayLeavesNoGhost(t *testing.T) {
+	gs, _ := newTestGameServer(t)
+	first := &testConn{}
+	create(t, gs, first, "bob", "sekrit")
+	require.NoError(t, gs.dispatch(gameserver.NewHandlerParameter(first, command.Logout{})))
+
+	c := &testConn{}
+	require.NoError(t, gs.dispatch(gameserver.NewHandlerParameter(c, command.Login{Name: "bob", Password: "sekrit"})))
+	require.NoError(t, gs.dispatch(gameserver.NewHandlerParameter(c, command.Logout{Cause: "client disconnected"})))
+	settle(t, gs)
+
+	assert.False(t, gs.world.IsPlaying("Bob"), "no ghost")
+	assert.Empty(t, gs.inFlight)
+	assert.Empty(t, gs.gone)
+}
+
+// A store error mid-login still answers the conversation.
+func TestRecovering_aLoginThatErrs(t *testing.T) {
+	gs, _ := newTestGameServer(t)
+	c := &testConn{}
+	gs.recovering(gameserver.NewHandlerParameter(c, command.Login{Name: "Bob"}), func(*gameserver.HandlerParameter) error {
+		return errors.New("store unreachable")
+	})
+	assert.Equal(t, []any{event.LoginFailed{Reason: event.Unknown}}, c.sent)
+}
+
+// A Logout built before the login queued ahead of it attached a player still
+// takes that player out: it goes by the connection, not by its snapshot.
+func TestLogout_builtBeforeTheLoginLanded(t *testing.T) {
+	gs, _ := newTestGameServer(t)
+	first := &testConn{}
+	create(t, gs, first, "bob", "sekrit")
+	require.NoError(t, gs.dispatch(gameserver.NewHandlerParameter(first, command.Logout{})))
+
+	c := &testConn{}
+	require.NoError(t, gs.dispatch(gameserver.NewHandlerParameter(c, command.Login{Name: "bob", Password: "sekrit"})))
+	logout := gameserver.NewHandlerParameter(c, command.Logout{Cause: "client disconnected"}) // no player yet
+	settle(t, gs)                                                                             // checked: Bob is in
+	require.True(t, gs.world.IsPlaying("Bob"))
+	require.NoError(t, gs.dispatch(logout))
+
+	assert.False(t, gs.world.IsPlaying("Bob"), "no ghost")
+}
