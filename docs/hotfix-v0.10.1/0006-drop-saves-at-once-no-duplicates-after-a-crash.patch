From c7eecac80701f1301c4000212a5b39be44af05a5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 11:34:46 +0000
Subject: [PATCH 6/7] drop saves at once: no duplicates after a crash

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0165cfX3CZMtTWVCk9QNEtcV
---
 world/handlers.go   |  3 +++
 world/playersave.go | 17 +++++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/world/handlers.go b/world/handlers.go
index a1c9170..6216e68 100644
--- a/world/handlers.go
+++ b/world/handlers.go
@@ -103,5 +103,8 @@ func (w *World) HandleIncomingMessage(msg *gameserver.HandlerParameter) error {
 		msg.Fail(event.UnknownCommand)
 		return fmt.Errorf("unhandled command %T", msg.Command)
 	}
+	if _, dropped := msg.Command.(command.Drop); dropped {
+		w.saveHandedOver(msg.Player)
+	}
 	return nil
 }
diff --git a/world/playersave.go b/world/playersave.go
index c3a53a6..c76bae8 100644
--- a/world/playersave.go
+++ b/world/playersave.go
@@ -5,6 +5,23 @@ import (
 	"github.com/watchmud/watchmud/player"
 )
 
+// saveHandedOver saves, now rather than on the timer, a player who may just
+// have let something go where someone else can take it, and everyone in
+// their room. Otherwise a crash before the timed save brings the dropper
+// back still holding what the taker, saved on quitting, has as well. A save
+// is only queued, and one that changes nothing is skipped.
+func (w *World) saveHandedOver(p *player.Player) {
+	room := w.playerRoom(p)
+	if room == nil {
+		return
+	}
+	for _, other := range room.Players() {
+		if err := w.store.Save(w.record(other)); err != nil {
+			log.Error().Err(err).Str("player", other.Name()).Msg("saving after a hand-over")
+		}
+	}
+}
+
 // QueuePlayerRecords hands a record of everyone in the world to the store.
 // This is the timed save, and the last one at shutdown: whatever changed a
 // player -- a command, a fight, a death -- is in the next one.
